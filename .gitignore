# 虚拟环境
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# 环境配置（含数据库密码，绝不能提交）
.env

# 生成的数据文件（可由脚本重建）
app/static/geo/plots.geojson

# 内网穿透客户端：50MB 的二进制，且是平台相关的，不该进仓库。
# 由 start_public.bat 提示的地址单独下载（见该脚本里的说明）。
tools/

# IDE
.idea/
*.swp

# .vscode 只忽略个人偏好类文件，settings.json 要保留 ——
# 它把解释器指向项目 .venv，避免每个人 clone 后都要手动切（见 env_check.py 的说明）
.vscode/*
!.vscode/settings.json
